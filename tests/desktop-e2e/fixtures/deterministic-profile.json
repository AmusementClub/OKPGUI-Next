{
  "$schema_comment": "Deterministic desktop E2E fixture profile. Local mock only — never paid/live providers.",
  "profileId": "byok-desktop-e2e-deterministic-v1",
  "description": "Offline-friendly fixture profile for Windows/Linux desktop-webdriver and macOS packaged smoke. Used when DESKTOP_E2E_BINARY is set and a local mock provider is started on loopback.",
  "mockProvider": {
    "bindHost": "127.0.0.1",
    "preferredPort": 18765,
    "baseUrlEnv": "DESKTOP_E2E_MOCK_PROVIDER_URL",
    "notesFile": "tests/desktop-e2e/fixtures/mock-provider.md",
    "neverLeaveLoopback": true,
    "neverUseLiveCredentials": true,
    "scenarios": {
      "formalAuditGo": {
        "decision": "GO",
        "findings": [],
        "usage": { "promptTokens": 12, "completionTokens": 4 }
      },
      "formalAuditWarning": {
        "decision": "WARNING",
        "findings": [
          {
            "code": "FIXTURE_WARNING",
            "severity": "warning",
            "message": "Deterministic fixture warning for ack path"
          }
        ]
      },
      "transportError": {
        "mode": "drop-connection",
        "purpose": "failed-poll recovery without backend terminal evidence"
      },
      "visionCandidates": {
        "candidateCount": 3,
        "maxImages": 5,
        "urls": [
          "http://127.0.0.1:18765/fixture/vision/a.jpg",
          "http://127.0.0.1:18765/fixture/vision/b.jpg",
          "http://127.0.0.1:18765/fixture/vision/c.jpg"
        ]
      }
    }
  },
  "media": {
    "controlledPaths": [
      "tests/desktop-e2e/fixtures/media/README.md"
    ],
    "usePackagedOrFakeMediaInfo": true,
    "forbidAbsoluteUserHomeProbes": true
  },
  "publishDraft": {
    "torrentName": "Fixture.Show.S01E01.1080p.fixture.mkv",
    "titleTemplateHint": "deterministic-local-title",
    "notes": "Title remains deterministic local template rules; AI suggested_title is display-only."
  },
  "selectors": {
    "homePrepare": "[data-testid=\"home-prepare\"], [data-testid=\"ai-preflight-panel\"]",
    "quickPublishPrepare": "[data-testid=\"quick-publish-prepare\"], [data-testid=\"ai-preflight-panel\"]",
    "preflightPanel": "[data-testid=\"ai-preflight-panel\"]",
    "preflightStatus": "[data-testid=\"ai-preflight-status\"]",
    "preflightCancel": "[data-testid=\"ai-preflight-cancel\"]",
    "preflightRetry": "[data-testid=\"ai-preflight-retry\"]",
    "preflightRetryReconciliation": "[data-testid=\"ai-preflight-retry-reconciliation\"]",
    "preflightError": "[data-testid=\"ai-preflight-error\"]",
    "visionDisclosure": "[data-testid=\"ai-preflight-vision-disclosure\"]",
    "visionSelectAll": "[data-testid=\"ai-preflight-vision-select-all\"]",
    "visionUseSelected": "[data-testid=\"ai-preflight-vision-use-selected\"]",
    "visionTextOnly": "[data-testid=\"ai-preflight-vision-text-only\"]",
    "advisoryDisclaimer": "[data-testid=\"ai-preflight-advisory-disclaimer\"]"
  },
  "ipc": {
    "forbidden": [
      "window.__TAURI_INTERNALS__ mock from Vite test bridge",
      "Playwright mocked invoke"
    ],
    "requiredProductionCommands": [
      "prepare_plan",
      "inspect_plan",
      "set_plan_acknowledgements",
      "publish_prepared_plan",
      "ai_cancel_preflight_session",
      "ai_poll_formal_audit",
      "ai_list_plan_vision_candidates",
      "ai_bind_plan_vision"
    ],
    "productionIpcMarkerRule": "true only for desktop-webdriver after real WebView Tauri IPC; host-binary-smoke and macos-packaged-smoke must keep productionIpcMarker false and use productionBinaryMarker",
    "productionBinaryMarkerRule": "true when host/packaged binary smoke hard probes pass inside the built binary"
  },
  "evidence": {
    "harnessTypes": {
      "windowsLinuxPrimary": "host-binary-smoke",
      "windowsLinuxWebDriver": "desktop-webdriver",
      "macos": "macos-packaged-smoke"
    },
    "schema": "tests/desktop-e2e/evidence.schema.json"
  }
}
